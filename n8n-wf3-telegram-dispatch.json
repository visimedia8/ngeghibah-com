[
  {
    "name": "NGEGHIBAH-03-TELEGRAM-DISPATCH",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "ngeghibah-dispatch",
          "responseMode": "onReceived",
          "options": {}
        },
        "id": "ngeghibah-dispatch-webhook",
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 1,
        "webhookId": "ngeghibah-dispatch-webhook",
        "position": [
          200,
          300
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://ngeghibah.com/api/webhooks/n8n/article",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "Bearer ngeghibah-super-secret-key-2026"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ title: ($json.body?.title || $json.title), slug: ($json.body?.slug || $json.slug), meta_description: ($json.body?.meta_description || $json.meta_description || ''), excerpt: ($json.body?.excerpt || $json.excerpt || ''), category: ($json.body?.category || $json.category || 'seleb-lokal'), ghibah_meter: ($json.body?.ghibah_meter || $json.ghibah_meter || 'FAKTA_TERVERIFIKASI'), hero_image: ($json.body?.hero_image || $json.hero_image || ''), entities: ($json.body?.entities || $json.entities || []), timeline: ($json.body?.timeline || $json.timeline || []), content_html: ($json.body?.content_html || $json.content_html), status: 'published' }) }}"
        },
        "id": "2",
        "name": "Auto-Publish to NgeGhibah Edge",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          440,
          300
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{ $env.CLOUDFLARE_DEPLOY_HOOK_URL || 'https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/dummy' }}",
          "options": {}
        },
        "id": "3",
        "name": "Trigger Cloudflare Pages Deploy Hook",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "onError": "continueRegularOutput",
        "position": [
          680,
          300
        ]
      },
      {
        "parameters": {
          "jsCode": "const raw = $input.first().json;\nconst data = raw.body || raw;\nconst title = data.title || 'Artikel Baru';\nconst slug = data.slug || '';\nconst meter = data.ghibah_meter || 'TERVERIFIKASI';\nconst category = data.category || 'seleb-lokal';\n\nconst telegramMessage = `🚀 *[LIVE AUTO-PUBLISHED] ARTIKEL TAYANG DI NGEGHIBAH.COM*\\n\\n` +\n  `📌 *Judul:* ${title}\\n` +\n  `🎯 *Kategori:* #${category}\\n` +\n  `⚖️ *Ghibah Meter:* ${meter}\\n\\n` +\n  `🔗 *URL Live:* https://ngeghibah.com/artikel/${slug}\\n` +\n  `⚡ *Status:* Terbit Instan & Terindeks ke Cloudflare Global CDN!`;\n\nreturn [{ json: { telegramMessage, ...data } }];"
        },
        "id": "4",
        "name": "Format Live Telemetry Log",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          920,
          300
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: $json.telegramMessage, parse_mode: 'Markdown' }) }}"
        },
        "id": "5",
        "name": "Send Live Broadcast to Telegram",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "onError": "continueRegularOutput",
        "position": [
          1160,
          300
        ]
      }
    ],
